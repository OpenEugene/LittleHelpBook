@namespace OpenEugene.Module.PhoneNumber
@inherits ModuleBase


@if (_list != null)
{
    @if (_list.Any())
    {
        <MudCard Outlined="true" >
            <MudCardHeader>
                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">Phone Numbers(s)</MudText>
                    <AuthorizeView Roles="@(LhbRoleNames.Editors)">
                        <Authorized>
                            <MudIconButton Color="Color.Primary"  OnClick="@(() => Add())" Icon="@MudBlazor.Icons.Material.Filled.AddCircleOutline" aria-label="add" />
                        </Authorized>
                    </AuthorizeView>
                </MudStack>
            </MudCardHeader>
            <MudCardContent>
                <MudDataGrid Items="@_list" Filterable="false" SortMode="@SortMode.None" Groupable="false" Outlined="true">
                    <Columns>
                        <PropertyColumn Property="x => x.FullNumber" Title="Number"  />
                        <PropertyColumn Property="x => x.Description" />
                        <AuthorizeView Roles="@(LhbRoleNames.Editors)" Context="authCon">
                            <Authorized>
                                <TemplateColumn>
                                    <CellTemplate>
                                        <MudStack row AlignItems="AlignItems.End">
                                            <MudIconButton Color="Color.Primary" OnClick="@(m => Edit(context.Item))" Icon="@MudBlazor.Icons.Material.Filled.Edit" aria-label="edit" />
                                            <MudIconButton Color="Color.Tertiary" OnClick="@(m => Delete(context.Item))" Icon="@MudBlazor.Icons.Material.Filled.Delete" aria-label="delete" />
                                        </MudStack>
                                    </CellTemplate>
                                </TemplateColumn>
                            </Authorized>
                        </AuthorizeView>
                    </Columns>
                </MudDataGrid>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <p><em>No phone numbers found.</em></p>
        <AuthorizeView Roles="LhbRoles.Editors" Context="authCon" >
            <Authorized>
                <MudIconButton OnClick="@(m => Add())" Icon="@MudBlazor.Icons.Material.Filled.AddCircleOutline" aria-label="add" />
            </Authorized>
        </AuthorizeView>
    }
}
