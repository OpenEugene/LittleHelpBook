@namespace OpenEugene.Module.PhoneNumber
@inherits ModuleBase
@* Required *@
<MudThemeProvider IsDarkMode=true />
<MudPopoverProvider />

@* Needed for dialogs *@ 
<MudDialogProvider />

@* Needed for snackbars 
<MudSnackbarProvider />*@

@if (_list == null)
{
<p><em>Loading...</em></p>
}
else
{
    @if (_list.Any())
    {
        <MudField Label="Phone Number(s)" Variant="Variant.Outlined">
            <MudDataGrid Items="@_list" Filterable="false" SortMode="@SortMode.None" Groupable="false">
                <Columns>
                    <PropertyColumn Property="x => x.FullNumber" Title="Number"  />
                    <PropertyColumn Property="x => x.Description" />
                    <AuthorizeView Roles="@(LhbRoleNames.Editors)" Context="authCon">
                        <Authorized>
                            <TemplateColumn>
                                <HeaderTemplate>
                                    <MudStack row AlignItems="AlignItems.End">
                                        <MudIconButton OnClick="@(m => Add())" Icon="@MudBlazor.Icons.Material.Filled.AddCircleOutline" aria-label="add" />
                                    </MudStack>                               
                                </HeaderTemplate>
                                <CellTemplate>
                                    <MudStack row AlignItems="AlignItems.End">
                                        <MudIconButton OnClick="@(m => Edit(context.Item))" Icon="@MudBlazor.Icons.Material.Filled.Edit" aria-label="edit" />
                                        <MudIconButton OnClick="@(m => Delete(context.Item))" Icon="@MudBlazor.Icons.Material.Filled.Delete" aria-label="delete" />
                                    </MudStack>
                                </CellTemplate>
                            </TemplateColumn>
                        </Authorized>
                    </AuthorizeView>
                </Columns>
            </MudDataGrid>
        </MudField>
    }
    else
    {
        <p><em>No phone numbers found.</em></p>
        <AuthorizeView Roles="LhbRoles.Editors" Context="authCon" >
            <Authorized>
                <MudIconButton OnClick="@(m => Add())" Icon="@MudBlazor.Icons.Material.Filled.AddCircleOutline" aria-label="add" />
            </Authorized>
        </AuthorizeView>
    }
}
