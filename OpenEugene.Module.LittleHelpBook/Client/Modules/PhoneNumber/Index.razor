@namespace OpenEugene.Module.PhoneNumber
@inherits ModuleBase
@* Required *@
<MudThemeProvider IsDarkMode=true />
<MudPopoverProvider />

@* Needed for dialogs 
<MudDialogProvider />*@

@* Needed for snackbars 
<MudSnackbarProvider />*@

@if (_list == null)
{
<p><em>Loading...</em></p>
}
else
{
    @if (_list.Any())
    {
        <MudDataGrid Items="@_list" Filterable="false" SortMode="@SortMode.None" Groupable="false">
            <Columns>
                <PropertyColumn Property="x => x.AreaCode" Title="Area" />
                <PropertyColumn Property="x => x.Number" />
                <PropertyColumn Property="x => x.Description" Title="Years Employed" />
                <AuthorizeView Roles="LhbRoles.Editors" Context="authCon" >
                    <Authorized>
                        <TemplateColumn CellClass="d-flex justify-end">
                            <CellTemplate>
                                <MudStack row>
                                <ActionLink Action="Edit" Text="Edit" ResourceKey="Edit" Parameters="@($"id={context.Item.PhoneNumberId}")" />
                                <ActionLink Action="Delete" Text="Delete" ResourceKey="Delete" Parameters="@($"id={context.Item.PhoneNumberId}")" />
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                    </Authorized>
                </AuthorizeView>
            </Columns>
        </MudDataGrid>
    }
    else
    {
        <AuthorizeView Roles="LhbRoles.Editors" Context="authCon" >
            <Authorized>
                <ActionLink Action="Add" Text="Add Phone Number" ResourceKey="Add" Parameters="@($"ProviderId={_providerId}")" />
            </Authorized>
        </AuthorizeView>
    }
}
