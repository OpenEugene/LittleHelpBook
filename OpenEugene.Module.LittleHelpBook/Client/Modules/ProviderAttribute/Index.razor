@namespace OpenEugene.Module.ProviderAttribute
@inherits ModuleBase
@* Required *@
<MudThemeProvider IsDarkMode=true />
<MudPopoverProvider />

@* Needed for dialogs 
<MudDialogProvider />*@

@* Needed for snackbars 
<MudSnackbarProvider />*@

@if (_list == null)
{
<p><em>Loading...</em></p>
}
else
{
    <MudField Label="Services" Variant="Variant.Outlined">
        <AuthorizeView Roles="@(LhbRoleNames.Editors)" >
            <Authorized>
                @foreach (var item in _list)
                {
                    <MudChip T="string" Color="Color.Primary" OnClose="@(()=>Delete(item.Attribute))">@item.Attribute.Name</MudChip>
                }
               <MudIconButton OnClick="@(() => Add())" Icon="@MudBlazor.Icons.Material.Filled.AddCircleOutline" aria-label="add" />
            </Authorized>
            <NotAuthorized>
                @foreach (var item in _list)
                {
                    <MudChip T="string" Color="Color.Primary">@item.Attribute.Name</MudChip>
                }
            </NotAuthorized>
        </AuthorizeView>

    </MudField>
}
