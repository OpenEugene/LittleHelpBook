@namespace OpenEugene.Module.ProviderAttribute
@inherits ModuleBase


@if (_list != null)
{
    <MudCard  Outlined="true" >
        <MudCardHeader>
            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">Services</MudText>
                <AuthorizeView Roles="@(LhbRoleNames.Editors)">
                    <Authorized>
                        <MudIconButton Color="Color.Primary"  OnClick="@(() => Add())" Icon="@MudBlazor.Icons.Material.Filled.AddCircleOutline" aria-label="add" />
                    </Authorized>
                </AuthorizeView>
            </MudStack>
        </MudCardHeader>
        <MudCardContent>
            <AuthorizeView Roles="@(LhbRoleNames.Editors)">
                <Authorized>
                    <MudStack Row Wrap="Wrap.Wrap">
                        @foreach (var item in _list)
                        {
                            <MudChip Color="Color.Default" 
                                Variant="@(item.Attribute.ParentAttributeId==null ? Variant.Filled : Variant.Outlined)" 
                                T="string" 
                                OnClose="@(()=>Delete(item.Attribute))">
                                    @item.Attribute.Name
                            </MudChip>
                        }
                    </MudStack>
                </Authorized>
                <NotAuthorized>
                    <MudStack Row Wrap="Wrap.Wrap">                     
                        @foreach (var item in _list)
                        {
                            <MudChip Variant="@(item.Attribute.ParentAttributeId==null ? Variant.Filled : Variant.Outlined)" T="string">@item.Attribute.Name</MudChip>
                        }
                    </MudStack>
                </NotAuthorized>
            </AuthorizeView>
        </MudCardContent>
    </MudCard>
}
