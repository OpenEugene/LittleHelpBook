@namespace OpenEugene.Module.ProviderAttribute
@inherits ModuleBase
@* Required *@
<MudThemeProvider IsDarkMode=true />
<MudPopoverProvider />

@* Needed for dialogs 
<MudDialogProvider />*@

@* Needed for snackbars 
<MudSnackbarProvider />*@

@if (_list == null)
{
<p><em>Loading...</em></p>
}
else
{
    <MudCard>
        <MudCardHeader>
            <MudText Typo="Typo.h6">Services</MudText>
        </MudCardHeader>
        <MudCardContent>
            <AuthorizeView Roles="@(LhbRoleNames.Editors)">
                <Authorized>
                    <MudStack Row Wrap="Wrap.Wrap">
                        @foreach (var item in _list)
                        {
                            <MudChip Variant="@(item.Attribute.ParentAttributeId==null ? Variant.Filled : Variant.Outlined)" T="string" OnClose="@(()=>Delete(item.Attribute))">@item.Attribute.Name</MudChip>
                        }
                    </MudStack>
                    <MudIconButton OnClick="@(() => Add())" Icon="@MudBlazor.Icons.Material.Filled.AddCircleOutline" aria-label="add" />
                </Authorized>
                <NotAuthorized>
                    <MudStack Row Wrap="Wrap.Wrap">                     
                        @foreach (var item in _list)
                        {
                            <MudChip Variant="@(item.Attribute.ParentAttributeId==null ? Variant.Filled : Variant.Outlined)" T="string">@item.Attribute.Name</MudChip>
                        }
                    </MudStack>
                </NotAuthorized>
            </AuthorizeView>
        </MudCardContent>
    </MudCard>
}
