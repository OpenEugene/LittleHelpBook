@namespace OpenEugene.Module.ProviderSearch
@inherits ModuleBase


@if (_list != null)
{
    <MudDataGrid 
        Items="@_list"
        T="M.Provider"
        RowClick="@Selected"
        SortMode="SortMode.Multiple"
        Filterable="true"
        QuickFilter="@_quickFilter">
        <ToolBarContent>
            <MudStack Row>
                <MudText Typo="Typo.h6">Search:</MudText>
                <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                    AdornmentIcon="@MudBlazor.Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                @*  <MudIconButton Title="New" Icon="@MudBlazor.Icons.Material.Filled.AddCard" Color="Color.Default" OnClick="Add" />
                *@ 
                <MudText Typo="Typo.h6">Filter(s):</MudText>
                <MudIconButton Color="Color.Primary" OnClick="@(() => AddFilter())" Icon="@MudBlazor.Icons.Material.Filled.AddCircleOutline" aria-label="add" />
            </MudStack>
        </ToolBarContent>
        <Columns>
            <TemplateColumn>
                <CellTemplate>
                    <AuthorizeView Roles="Editors" Context="auth">
                        <Authorized>
                            <MudIconButton Size="@Size.Small"
                                            Icon="@MudBlazor.Icons.Material.Outlined.Edit"
                                            OnClick="@(()=>Edit(context.Item))" />
                        </Authorized>
                        <NotAuthorized>
                            <MudIconButton Size="@Size.Small"
                                            Icon="@MudBlazor.Icons.Material.Filled.Preview"
                                            OnClick="@(()=>Detail(context.Item))" />
                        </NotAuthorized>
                    </AuthorizeView>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Name" Title="Name" />
            <PropertyColumn Property="x => x.Description" />
        </Columns>
        <NoRecordsContent>
            <MudText>@Localizer["Message.DisplayNone"]</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="M.Provider" />
        </PagerContent>
    </MudDataGrid>
}
