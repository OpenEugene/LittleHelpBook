@namespace OpenEugene.Module.ProviderSearch
@inherits ModuleBase


@if (_list != null)
{
    <MudDataGrid 
        Items="@_list"
        T="M.Provider"
        RowClick="@Selected"
        SortMode="SortMode.Multiple"
        Filterable="true"
        QuickFilter="@_quickFilter">
        <ToolBarContent>
            <MudStack Row AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">Search</MudText>
                <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                    AdornmentIcon="@MudBlazor.Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                <MudButton Color="Color.Primary" OnClick="@(() => AddFilter())" StartIcon="@MudBlazor.Icons.Material.Filled.FilterAlt" aria-label="add">Filter</MudButton>
         
                @if (_filters != null && _filters.Length > 0)
                {
                  
                    @foreach (var cat in _attributes.Where(a => _filters.Contains(a.AttributeId)))
                    {
                        <MudChip
                            Variant="Variant.Outlined"
                            Size="Size.Small"      
                            Text="@cat.Name"
                            Value="@cat.AttributeId">
                        </MudChip>
                    }
       
                }
                <MudSpacer/>
                <AuthorizeView Roles="@($"{LhbRoleNames.Editors},{@RoleNames.Host}")" >
                    <MudIconButton Icon="@MudBlazor.Icons.Material.Filled.AddCard" Color="Color.Default" OnClick="Add" />
                </AuthorizeView>
            </MudStack>
        </ToolBarContent>
        <Columns>
            <TemplateColumn>
                <CellTemplate>
                    <AuthorizeView Roles="Editors" Context="auth">
                        <Authorized>
                            <MudIconButton Size="@Size.Small"
                                            Icon="@MudBlazor.Icons.Material.Outlined.Edit"
                                            OnClick="@(()=>Edit(context.Item))" />
                        </Authorized>
                        <NotAuthorized>
                            <MudIconButton Size="@Size.Small"
                                            Icon="@MudBlazor.Icons.Material.Filled.Preview"
                                            OnClick="@(()=>Detail(context.Item))" />
                        </NotAuthorized>
                    </AuthorizeView>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Name" Title="Name" />
            <PropertyColumn Property="x => x.Description" />
        </Columns>
        <NoRecordsContent>
            <MudText>@Localizer["Message.DisplayNone"]</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="M.Provider" />
        </PagerContent>
    </MudDataGrid>
}
